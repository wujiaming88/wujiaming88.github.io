<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:atom="http://www.w3.org/2005/Atom">
  <xsl:output method="html" version="1.0" encoding="UTF-8" indent="yes"/>
  <xsl:template match="/">
    <html lang="zh-CN">
      <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title><xsl:value-of select="atom:feed/atom:title"/> · RSS 订阅</title>
        <style>
          :root { --accent:#2563eb; --bg:#0E1116; --card:#161B22; --text:#e6edf3; --muted:#9ca3af; --border:#272e38; }
          * { box-sizing:border-box; }
          body { margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans CJK SC","PingFang SC","Microsoft YaHei",sans-serif; background:var(--bg); color:var(--text); line-height:1.6; }
          .wrap { max-width:760px; margin:0 auto; padding:2rem 1.2rem 4rem; }
          .banner { background:linear-gradient(135deg,#1d2530,#161B22); border:1px solid var(--border); border-radius:14px; padding:1.6rem 1.4rem; margin-bottom:2rem; }
          .banner h1 { margin:0 0 .4rem; font-size:1.5rem; }
          .banner .sub { color:var(--muted); font-size:.95rem; margin:0 0 1rem; }
          .rss-tip { background:rgba(37,99,235,.12); border:1px solid rgba(37,99,235,.4); border-radius:10px; padding:.9rem 1rem; font-size:.9rem; color:var(--text); }
          .rss-tip b { color:#60a5fa; }
          .rss-tip code { background:rgba(255,255,255,.08); padding:.1rem .4rem; border-radius:4px; font-size:.85rem; word-break:break-all; }
          .section-label { font-size:.8rem; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); margin:0 0 .8rem; }
          .entry { border:1px solid var(--border); border-radius:12px; padding:1rem 1.2rem; margin-bottom:.9rem; background:var(--card); transition:border-color .2s; }
          .entry:hover { border-color:var(--accent); }
          .entry a { color:var(--text); text-decoration:none; font-weight:600; font-size:1.05rem; }
          .entry a:hover { color:#60a5fa; }
          .entry .date { color:var(--muted); font-size:.82rem; margin-top:.35rem; }
          .foot { text-align:center; color:var(--muted); font-size:.82rem; margin-top:2rem; }
          .foot a { color:#60a5fa; text-decoration:none; }
          @media (max-width:520px){ .banner h1{font-size:1.25rem;} }
        </style>
      </head>
      <body>
        <div class="wrap">
          <div class="banner">
            <h1>📡 <xsl:value-of select="atom:feed/atom:title"/></h1>
            <p class="sub"><xsl:value-of select="atom:feed/atom:subtitle"/></p>
            <div class="rss-tip">
              <b>这是一个 RSS 订阅源。</b> 复制本页地址到你的 RSS 阅读器（如 Feedly、Inoreader、NetNewsWire、Follow）即可订阅，有新文章会自动推送。<br/>
              订阅地址：<code><xsl:value-of select="atom:feed/atom:id"/></code>
            </div>
          </div>

          <p class="section-label">最近更新</p>
          <xsl:for-each select="atom:feed/atom:entry">
            <div class="entry">
              <a target="_blank">
                <xsl:attribute name="href"><xsl:value-of select="atom:link/@href"/></xsl:attribute>
                <xsl:value-of select="atom:title"/>
              </a>
              <div class="date">
                📅 <xsl:value-of select="substring(atom:published,1,10)"/>
              </div>
            </div>
          </xsl:for-each>

          <div class="foot">
            <a target="_blank">
              <xsl:attribute name="href"><xsl:value-of select="atom:feed/atom:link[@rel='alternate']/@href"/></xsl:attribute>
              ← 返回博客首页
            </a>
          </div>
        </div>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>
