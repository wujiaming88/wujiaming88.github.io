{
  "name": "study-cards",
  "version": "1.0.0",
  "description": "Anki-style flashcard system for architecture exam",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "extract": "node extract-cards.js",
    "build": "node build.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "jsdom": "^29.1.1"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "sm2.js",
      "queue.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  }
}
